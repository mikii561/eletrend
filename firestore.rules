rules_version = '2';

// LIFEUP adatbázis-szabályai. Minden jogosultság itt dől el, nem az appban.
// - users/: mindenki csak a saját adatait látja (az admin sem olvashatja, csak törölheti).
// - availability/: csak szabad/foglalt időszakok, és csak a tulajdonos által kiválasztott barátok olvashatják.
// - events/: közös programok; a link ismerője látja, kivéve a „csak meghívottaknak” programokat.
// - blocks/: akit letiltottam, nem jelölhet, nem hívhat meg, nem bökhet meg.
// - admins/: ki admin. Csak a Firebase konzolban lehet beállítani, az appból nem.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function realUser() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function banned() {
      return signedIn() && exists(/databases/$(database)/documents/bans/$(request.auth.uid));
    }

    function isFriend(uid, other) {
      return exists(/databases/$(database)/documents/friendships/$(uid)/list/$(other));
    }

    function blockedBy(uid, other) {
      return exists(/databases/$(database)/documents/blocks/$(uid)/list/$(other));
    }

    // Láthatja-e a bejelentkezett felhasználó a közös programot.
    function canSeeEvent(eventId) {
      let e = get(/databases/$(database)/documents/events/$(eventId)).data;
      return signedIn() && (e.get('inviteOnly', false) != true
        || e.ownerUid == request.auth.uid
        || request.auth.uid in e.get('invitedUids', [])
        || isAdmin());
    }

    // Láthatja-e a fotót: a sajátját mindig; a többit, ha látja a programot, és a fotó mindenkinek
    // szól, vagy ő is ott volt (rajta van a „going” listán).
    function canSeePhoto(eventId) {
      return canSeeEvent(eventId) && (resource.data.uid == request.auth.uid
        || resource.data.audience == 'all'
        || request.auth.uid in get(/databases/$(database)/documents/events/$(eventId)).data.get('going', []));
    }

    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Felfüggesztett fiókok: az admin kezeli, a felhasználó csak a sajátját látja.
    match /bans/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list, write: if isAdmin();
    }

    // A felhasználó saját adatai (naptár, feladatok, célok, csoportok, beállítások).
    match /users/{uid}/{document=**} {
      allow read, write: if realUser() && request.auth.uid == uid && !banned();
      allow delete: if isAdmin();
    }

    // Adatlap az admin felülethez: név, e-mail, utolsó aktivitás, darabszámok (tartalom nélkül).
    match /profiles/{uid} {
      allow get: if isAdmin() || (realUser() && request.auth.uid == uid);
      allow list, delete: if isAdmin();
      allow write: if realUser() && request.auth.uid == uid && !banned()
        && request.resource.data.keys().hasOnly(['name', 'email', 'createdAt', 'lastSeen', 'platform', 'version', 'counts'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.email is string && request.resource.data.email.size() <= 200;
    }

    // Automatikus hibajelentések: bárki küldhet (akár vendég is), csak az admin olvashatja.
    match /errors/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['message', 'stack', 'uid', 'platform', 'version', 'at'])
        && request.resource.data.message is string && request.resource.data.message.size() <= 1000
        && request.resource.data.stack is string && request.resource.data.stack.size() <= 5000;
      allow read, delete: if isAdmin();
    }

    // „Hiba bejelentése / ötlet”: bejelentkezett felhasználó küldheti, az admin kezeli.
    match /feedback/{id} {
      allow create: if realUser()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'text', 'platform', 'version', 'done', 'at'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.done == false;
      allow read, update, delete: if isAdmin();
    }

    // Jelentés egy felhasználóról vagy programról: bárki (valódi fiókkal) küldhet, csak az admin látja.
    match /reports/{id} {
      allow create: if realUser() && !banned()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['reporterUid', 'userUid', 'eventId', 'reason', 'at'])
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 500;
      allow read, delete: if isAdmin();
    }

    // Barátkód → felhasználó. Aki ismeri a kódot, megnézheti; mindenki csak a sajátját hozhatja létre.
    match /codes/{code} {
      allow get: if realUser();
      allow list, update, delete: if false;
      allow create: if realUser()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid']);
    }

    // Névjegy (név, kód, és amit megoszt: sorozatok, születésnap év nélkül): saját maga és a barátai olvashatják.
    // Az `invites` mező (hívhatnak-e meg) a meghívó-szabálynál számít.
    match /people/{uid} {
      allow get: if realUser() && (request.auth.uid == uid || isFriend(uid, request.auth.uid));
      allow write: if realUser() && request.auth.uid == uid && !banned()
        && request.resource.data.keys().hasOnly(['name', 'code', 'streaks', 'birthday', 'invites', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.streaks is list && request.resource.data.streaks.size() <= 5
        && (request.resource.data.get('birthday', null) == null
          || (request.resource.data.birthday is string && request.resource.data.birthday.matches('[0-9]{2}-[0-9]{2}')));
      allow delete: if isAdmin();
    }

    // Elérhetőség: csak foglalt időszakok (cím nélkül) és „mikor szoktam ráérni” sávok.
    // Csak a `viewers` listában szereplők olvashatják; a listát a tulajdonos állítja.
    match /availability/{uid} {
      allow get: if realUser() && (request.auth.uid == uid || request.auth.uid in resource.data.viewers);
      allow list: if false;
      allow create, update: if realUser() && request.auth.uid == uid && !banned()
        && request.resource.data.keys().hasOnly(['manual', 'manualUntil', 'busy', 'windows', 'offset', 'viewers', 'updatedAt'])
        && request.resource.data.busy is list && request.resource.data.busy.size() <= 400
        && request.resource.data.windows is list && request.resource.data.windows.size() <= 20
        && request.resource.data.viewers is list && request.resource.data.viewers.size() <= 1000;
      allow delete: if (realUser() && request.auth.uid == uid) || isAdmin();
    }

    // Letiltás: mindenki a saját listáját kezeli.
    match /blocks/{uid}/list/{other} {
      allow read, write: if realUser() && request.auth.uid == uid;
    }

    // Barátjelölés: a küldő a saját nevében küldhet (ha nincs letiltva); a címzett látja és törli.
    match /requests/{to}/items/{from} {
      allow read: if realUser() && request.auth.uid == to;
      allow create, update: if realUser() && request.auth.uid == from && from != to && !banned()
        && !blockedBy(to, from)
        && request.resource.data.keys().hasOnly(['fromName', 'at'])
        && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 40;
      allow delete: if realUser() && (request.auth.uid == to || request.auth.uid == from);
    }

    // Barátság: csak egy meglévő jelölés elfogadásával jöhet létre (mindkét oldalon).
    match /friendships/{uid}/list/{friend} {
      allow read: if realUser() && request.auth.uid == uid;
      allow create, update: if realUser() && !banned()
        && request.resource.data.keys().hasOnly(['name', 'since'])
        && ((request.auth.uid == uid && exists(/databases/$(database)/documents/requests/$(uid)/items/$(friend)))
          || (request.auth.uid == friend && exists(/databases/$(database)/documents/requests/$(friend)/items/$(uid))));
      allow delete: if realUser() && (request.auth.uid == uid || request.auth.uid == friend);
    }

    // Meghívás egy gombnyomással: csak barát küldhet, ha a címzett nem tiltotta le és nem kapcsolta ki.
    match /inbox/{uid}/items/{eventId} {
      allow read, delete: if realUser() && request.auth.uid == uid;
      allow create, update: if realUser() && !banned()
        && request.resource.data.fromUid == request.auth.uid
        && isFriend(uid, request.auth.uid)
        && !blockedBy(uid, request.auth.uid)
        && (!exists(/databases/$(database)/documents/people/$(uid))
          || get(/databases/$(database)/documents/people/$(uid)).data.get('invites', true) != false)
        && request.resource.data.keys().hasOnly(['title', 'date', 'fromUid', 'fromName', 'at'])
        && request.resource.data.title is string && request.resource.data.title.size() <= 100;
    }

    // Bökés: csak barát küldhet, naponta legfeljebb 3-at ugyanannak (az azonosító: küldő_nap_0–2,
    // és meglévőt nem lehet felülírni), és csak ha a címzett nem kapcsolta ki / nem némította.
    match /nudges/{to}/items/{id} {
      allow read, delete: if realUser() && request.auth.uid == to;
      allow update: if realUser() && request.auth.uid == to
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen']);
      allow create: if realUser() && !banned()
        && request.resource.data.fromUid == request.auth.uid
        && id.matches(request.auth.uid + '_[0-9]{8}_[0-2]')
        && isFriend(to, request.auth.uid)
        && !blockedBy(to, request.auth.uid)
        && (!exists(/databases/$(database)/documents/nudgeSettings/$(to))
          || (get(/databases/$(database)/documents/nudgeSettings/$(to)).data.get('off', false) != true
            && !(request.auth.uid in get(/databases/$(database)/documents/nudgeSettings/$(to)).data.get('muted', []))))
        && request.resource.data.keys().hasOnly(['fromUid', 'fromName', 'text', 'emoji', 'eventId', 'eventTitle', 'seen', 'at'])
        && request.resource.data.seen == false
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 120
        && request.resource.data.emoji is string && request.resource.data.emoji.size() <= 16;
    }

    // Bökés-beállítások (kikapcsolás, némítás): csak a saját.
    match /nudgeSettings/{uid} {
      allow read, write: if realUser() && request.auth.uid == uid;
    }

    // Közös kihívás és közös cél: csak a tagjai látják; a szervező kezeli, a többiek kiléphetnek.
    match /challenges/{cid} {
      allow read: if realUser() && request.auth.uid in resource.data.members;
      allow create: if realUser() && !banned()
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() <= 20
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 60
        && request.resource.data.days is int && request.resource.data.days <= 366;
      allow update: if realUser() && (
        (resource.data.ownerUid == request.auth.uid && request.resource.data.ownerUid == request.auth.uid)
        || (request.auth.uid in resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names'])
          && !(request.auth.uid in request.resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() - 1));
      allow delete: if realUser() && resource.data.ownerUid == request.auth.uid;

      // Haladás: mindenki a sajátját írja; a többiek csak buzdíthatnak (+1 taps).
      match /progress/{uid} {
        allow read: if realUser()
          && request.auth.uid in get(/databases/$(database)/documents/challenges/$(cid)).data.members;
        allow create: if realUser() && request.auth.uid == uid && !banned()
          && request.auth.uid in get(/databases/$(database)/documents/challenges/$(cid)).data.members
          && request.resource.data.keys().hasOnly(['name', 'done', 'cheers'])
          && request.resource.data.cheers == 0
          && request.resource.data.done is list && request.resource.data.done.size() <= 400;
        allow update: if realUser() && !banned()
          && request.auth.uid in get(/databases/$(database)/documents/challenges/$(cid)).data.members
          && ((request.auth.uid == uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'done'])
              && request.resource.data.done.size() <= 400)
            || (request.auth.uid != uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cheers'])
              && request.resource.data.cheers == resource.data.cheers + 1));
        allow delete: if realUser() && (request.auth.uid == uid
          || get(/databases/$(database)/documents/challenges/$(cid)).data.ownerUid == request.auth.uid);
      }
    }

    // Közös program. A szervező bármit módosíthat; a résztvevők csak a saját nevüket tehetik fel a
    // „going” listára vagy vehetik le, és a létszámkorlátot a szabály ellenőrzi.
    match /events/{eventId} {
      allow get: if signedIn() && (resource.data.get('inviteOnly', false) != true
        || resource.data.ownerUid == request.auth.uid
        || request.auth.uid in resource.data.get('invitedUids', [])
        || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn() && !banned()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 100
        && request.resource.data.get('going', []).size() <= 1;
      allow update: if signedIn() && !banned() && (
        (resource.data.ownerUid == request.auth.uid && request.resource.data.ownerUid == request.auth.uid)
        || (canSeeEvent(eventId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['going'])
          && request.resource.data.going.toSet().difference(resource.data.get('going', []).toSet())
            .union(resource.data.get('going', []).toSet().difference(request.resource.data.going.toSet()))
            .hasOnly([request.auth.uid])
          && (resource.data.get('limit', null) == null
            || request.resource.data.going.size() <= resource.data.limit
            || request.resource.data.going.size() < resource.data.get('going', []).size())));
      allow delete: if (signedIn() && resource.data.ownerUid == request.auth.uid) || isAdmin();

      // Visszajelzés és szavazat: mindenki csak a sajátját írhatja.
      match /rsvps/{uid} {
        allow read: if canSeeEvent(eventId);
        allow write: if canSeeEvent(eventId) && !banned()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['name', 'status', 'votes', 'updatedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 40
          && request.resource.data.status in ['yes', 'maybe', 'no', 'none']
          && request.resource.data.votes is list
          && request.resource.data.votes.size() <= 10;
        allow delete: if isAdmin();
      }

      // Reakció: mindenki egyet, a sajátját.
      match /reactions/{uid} {
        allow read: if canSeeEvent(eventId);
        allow write: if canSeeEvent(eventId) && !banned() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['emoji'])
          && request.resource.data.emoji is string && request.resource.data.emoji.size() <= 16;
        allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
      }

      // Közös fotók (emlékek). A feltöltő dönti el, ki láthatja: mindenki, aki látja a programot ('all'),
      // vagy csak akik mentek ('going'). A lista az előnézetet, a photoData a teljes képet tartalmazza.
      match /photos/{photoId} {
        allow read: if canSeePhoto(eventId);
        allow create: if canSeeEvent(eventId) && !banned()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'name', 'thumb', 'audience', 'allowDownload', 'at'])
          && request.resource.data.audience in ['all', 'going']
          && request.resource.data.allowDownload is bool
          && request.resource.data.name is string && request.resource.data.name.size() <= 40
          && request.resource.data.thumb is string && request.resource.data.thumb.size() <= 80000;
        allow update: if signedIn() && resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['audience', 'allowDownload'])
          && request.resource.data.audience in ['all', 'going'];
        allow delete: if signedIn() && (resource.data.uid == request.auth.uid
          || get(/databases/$(database)/documents/events/$(eventId)).data.ownerUid == request.auth.uid
          || isAdmin());
      }

      match /photoData/{photoId} {
        allow read: if canSeePhoto(eventId);
        allow create: if canSeeEvent(eventId) && !banned()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'audience', 'data'])
          && request.resource.data.audience in ['all', 'going']
          && request.resource.data.data is string && request.resource.data.data.size() <= 900000;
        allow update: if signedIn() && resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['audience'])
          && request.resource.data.audience in ['all', 'going'];
        allow delete: if signedIn() && (resource.data.uid == request.auth.uid
          || get(/databases/$(database)/documents/events/$(eventId)).data.ownerUid == request.auth.uid
          || isAdmin());
      }

      // Hozzászólások: saját néven lehet írni; törölni a sajátot, szervezőként vagy adminként bármelyiket.
      match /messages/{messageId} {
        allow read: if canSeeEvent(eventId);
        allow create: if canSeeEvent(eventId) && !banned()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'at'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 40;
        allow delete: if signedIn()
          && (resource.data.uid == request.auth.uid
            || get(/databases/$(database)/documents/events/$(eventId)).data.ownerUid == request.auth.uid
            || isAdmin());
      }
    }
  }
}
