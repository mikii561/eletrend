rules_version = '2';

// Életrend adatbázis-szabályai.
// - users/: mindenki csak a saját adatait látja (az admin sem olvashatja a naplót, csak törölheti).
// - events/: közös programok; aki ismeri a (kitalálhatatlan) azonosítót, azaz megkapta a
//   meghívólinket, láthatja és visszajelezhet; módosítani a szervező (és moderáláskor az admin) tud.
// - admins/: ki admin. Csak a Firebase konzolban lehet beállítani, az appból nem.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function realUser() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function banned() {
      return signedIn() && exists(/databases/$(database)/documents/bans/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Felfüggesztett fiókok: az admin kezeli, a felhasználó csak a sajátját látja.
    match /bans/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list, write: if isAdmin();
    }

    // A felhasználó saját adatai (napló, szokások, programok…).
    match /users/{uid}/{document=**} {
      allow read, write: if realUser() && request.auth.uid == uid && !banned();
      allow delete: if isAdmin();
    }

    // Adatlap az admin felülethez: név, e-mail, utolsó aktivitás, darabszámok (napló tartalma nélkül).
    match /profiles/{uid} {
      allow get: if isAdmin() || (realUser() && request.auth.uid == uid);
      allow list, delete: if isAdmin();
      allow write: if realUser() && request.auth.uid == uid && !banned()
        && request.resource.data.keys().hasOnly(['name', 'email', 'createdAt', 'lastSeen', 'platform', 'version', 'counts'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.email is string && request.resource.data.email.size() <= 200;
    }

    // Automatikus hibajelentések: bárki küldhet (akár vendég is), csak az admin olvashatja.
    match /errors/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['message', 'stack', 'uid', 'platform', 'version', 'at'])
        && request.resource.data.message is string && request.resource.data.message.size() <= 1000
        && request.resource.data.stack is string && request.resource.data.stack.size() <= 5000;
      allow read, delete: if isAdmin();
    }

    // „Hiba bejelentése / ötlet”: bejelentkezett felhasználó küldheti, az admin kezeli.
    match /feedback/{id} {
      allow create: if realUser()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'text', 'platform', 'version', 'done', 'at'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.done == false;
      allow read, update, delete: if isAdmin();
    }

    // Barátkód → felhasználó. Aki ismeri a kódot, megnézheti; mindenki csak a sajátját hozhatja létre.
    match /codes/{code} {
      allow get: if realUser();
      allow list, update, delete: if false;
      allow create: if realUser()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid']);
    }

    // Névjegy (név, kód, megosztott sorozatok): saját maga és a barátai olvashatják.
    match /people/{uid} {
      allow get: if realUser() && (request.auth.uid == uid
        || exists(/databases/$(database)/documents/friendships/$(uid)/list/$(request.auth.uid)));
      allow write: if realUser() && request.auth.uid == uid && !banned()
        && request.resource.data.keys().hasOnly(['name', 'code', 'streaks', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.streaks is list && request.resource.data.streaks.size() <= 5;
      allow delete: if isAdmin();
    }

    // Barátjelölés: a küldő a saját nevében küldhet; a címzett látja és törli.
    match /requests/{to}/items/{from} {
      allow read: if realUser() && request.auth.uid == to;
      allow create, update: if realUser() && request.auth.uid == from && from != to && !banned()
        && request.resource.data.keys().hasOnly(['fromName', 'at'])
        && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 40;
      allow delete: if realUser() && (request.auth.uid == to || request.auth.uid == from);
    }

    // Barátság: csak egy meglévő jelölés elfogadásával jöhet létre (mindkét oldalon).
    match /friendships/{uid}/list/{friend} {
      allow read: if realUser() && request.auth.uid == uid;
      allow create, update: if realUser() && !banned()
        && request.resource.data.keys().hasOnly(['name', 'since'])
        && ((request.auth.uid == uid && exists(/databases/$(database)/documents/requests/$(uid)/items/$(friend)))
          || (request.auth.uid == friend && exists(/databases/$(database)/documents/requests/$(friend)/items/$(uid))));
      allow delete: if realUser() && (request.auth.uid == uid || request.auth.uid == friend);
    }

    // Meghívás egy gombnyomással: csak a barátod küldhet.
    match /inbox/{uid}/items/{eventId} {
      allow read, delete: if realUser() && request.auth.uid == uid;
      allow create, update: if realUser() && !banned()
        && request.resource.data.fromUid == request.auth.uid
        && exists(/databases/$(database)/documents/friendships/$(uid)/list/$(request.auth.uid))
        && request.resource.data.keys().hasOnly(['title', 'date', 'fromUid', 'fromName', 'at'])
        && request.resource.data.title is string && request.resource.data.title.size() <= 100;
    }

    match /events/{eventId} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create: if signedIn() && !banned()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 100;
      allow update: if signedIn() && !banned()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if (signedIn() && resource.data.ownerUid == request.auth.uid) || isAdmin();

      // Visszajelzés és szavazat: mindenki csak a sajátját írhatja.
      match /rsvps/{uid} {
        allow read: if signedIn();
        allow write: if signedIn() && !banned()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['name', 'status', 'votes', 'updatedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 40
          && request.resource.data.status in ['yes', 'maybe', 'no', 'none']
          && request.resource.data.votes is list
          && request.resource.data.votes.size() <= 10;
        allow delete: if isAdmin();
      }

      // Üzenőfal: saját néven lehet írni; törölni a sajátot, szervezőként vagy adminként bármelyiket.
      match /messages/{messageId} {
        allow read: if signedIn();
        allow create: if signedIn() && !banned()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'at'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 40;
        allow delete: if signedIn()
          && (resource.data.uid == request.auth.uid
            || get(/databases/$(database)/documents/events/$(eventId)).data.ownerUid == request.auth.uid
            || isAdmin());
      }
    }
  }
}
